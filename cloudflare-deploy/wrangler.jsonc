        "class_name": "ZoomMeetingStateDurableObject"
      },
      {
        "name": "ZOOM_SHARED_TIMER_STATE",
        "class_name": "ZoomSharedTimerStateDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "QueueStateDurableObject"
      ]
