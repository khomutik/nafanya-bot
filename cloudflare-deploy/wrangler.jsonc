        "class_name": "TimerStateDurableObject"
      },
      {
        "name": "LIGHT_TALK_STATE",
        "class_name": "LightTalkStateDurableObject"
      },
      {
        "name": "ANNOUNCEMENT_STATE",
        "class_name": "AnnouncementStateDurableObject"
      },
      {
